# =============================================================================
# Telegram Userbot - Configuration (template)
# =============================================================================
# Copy this file to .env and adjust the values. The .env file itself is
# gitignored and contains your real credentials.

# -----------------------------------------------------------------------------
# Telegram credentials  (REQUIRED — startup aborts when empty)
# -----------------------------------------------------------------------------
# Request an API id + hash at https://my.telegram.org/auth?to=apps
TG_ACCOUNT=@your_username
TG_PHONE_NR=+49xxxxxxxxxxx
TG_API_ID=0
TG_API_HASH=your_api_hash

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Timezone for keep-alive scheduling and log timestamps (IANA name)
TIMEZONE=Europe/Berlin

# Directory for log files (auto-created when missing)
LOGS_DIR=logs

# Daily log files older than this number of days are deleted on startup and
# after midnight rollover. 0 keeps only today's log file.
LOG_RETENTION_DAYS=10

# Path to the runtime config (listeners + keep-alives, hot-reloadable)
CONFIG_PATH=bot_config.json

# -----------------------------------------------------------------------------
# Chat commands
# -----------------------------------------------------------------------------
# true  = slash commands (/copy, /stop, /keepalive, ...) are active in chats
# false = no command handlers at all; the bot is purely passive and is
#         configured exclusively through bot_config.json
ENABLE_CHAT_COMMANDS=true

# Optionally restrict commands to a SINGLE chat id (e.g. a private group with
# just yourself), so slash commands only work there and stay out of every
# other conversation. 0 = commands work in every chat. Get the id via /show_id.
COMMANDS_CHAT_ID=0

# -----------------------------------------------------------------------------
# Control bot (optional)
# -----------------------------------------------------------------------------
# A separate BotFather bot with an inline-button menu to view the config and
# toggle per-chat settings (direction, view-once, keep-alive, ...). Leave the
# token empty to disable it. Create a bot with @BotFather to get the token.
CONTROL_BOT_TOKEN=

# Your own numeric user id — the ONLY user allowed to control the bot. Get it by
# sending /show_id to yourself in Saved Messages, or via @userinfobot. The
# control bot refuses to start without this, so nobody else can control it.
CONTROL_BOT_OWNER_ID=0

# -----------------------------------------------------------------------------
# Slash-command auto-delete (seconds)
# -----------------------------------------------------------------------------
# Default delay after which a /command + its reply are deleted
DELETE_DELAY_SECONDS=5

# Longer delay for /list_chats and /helpf (more to read)
LIST_CHATS_DELETE_DELAY_SECONDS=20

# Longest delay for /config all
CONFIG_ALL_DELETE_DELAY_SECONDS=30

# -----------------------------------------------------------------------------
# Config hot-reload and forward index
# -----------------------------------------------------------------------------
# How often bot_config.json is checked for mtime changes
CONFIG_RELOAD_INTERVAL_SECONDS=5

# How long source->target message mappings are kept (for edit propagation).
# Edits to source messages older than this are no longer propagated to targets.
# Default: 24 hours = 86400
FORWARD_RECORD_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Keep-alive
# -----------------------------------------------------------------------------
# Default time for new keep-alives when /keepalive is used without an argument
DEFAULT_KEEPALIVE_TIME=08:00:00

# Guard window against double sends (e.g. after a reload race). Within this
# window a second keep-alive attempt for the same chat is suppressed.
KEEPALIVE_DUPLICATE_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# Reconnect / network
# -----------------------------------------------------------------------------
# Wait time after a network/API error in app.start() before reconnecting
NETWORK_RETRY_DELAY_SECONDS=10

# -----------------------------------------------------------------------------
# Health check (hard exit for supervisor restart)
# -----------------------------------------------------------------------------
# pyrogram retry-loops connection errors internally without reporting them.
# An active ping (get_me) checks the connection periodically; if it stays
# dead for too long, the process exits hard so the supervisor can restart it.

# Interval between health pings
HEALTH_CHECK_INTERVAL_SECONDS=60

# Timeout per ping call (should be smaller than the interval)
HEALTH_CHECK_TIMEOUT_SECONDS=30

# After this many seconds without a successful health check, os._exit(1)
# is executed. Default: 15 minutes = 900
MAX_UNHEALTHY_DURATION_SECONDS=900
